# Cổng chạy API (giao diện Next gọi qua ZALO_BE_URL, mặc định :4100)
PORT=4100

# MongoDB (dùng database riêng để không lẫn với dự án khác)
MONGODB_URI=mongodb://127.0.0.1:27017/metus-zalo

# Khoá ký JWT — chuỗi ngẫu nhiên >= 32 ký tự. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Các nguồn (origin) được phép gọi API, ngăn cách bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000

# Cho phép người lạ tự đăng ký? Giao diện chưa có form đăng ký nên để false.
ALLOW_REGISTRATION=false

# Số tầng proxy tin cậy để đọc IP thật từ X-Forwarded-For (Next đứng ngay trước backend = 1)
TRUST_PROXY_HOPS=1

# Khi chạy thật đặt NODE_ENV=production (tắt Swagger); ENABLE_DOCS=true để bật lại
# NODE_ENV=production
# ENABLE_DOCS=false

# Khóa nội bộ để server Next gọi /api/internal/*
INTERNAL_KEY=

# Khoá mã hoá cookie Zalo tại lưu trữ (AES-256-GCM) — chuỗi ngẫu nhiên >= 32 ký tự
COOKIE_SECRET=

# Bot Telegram nhận yêu cầu dùng thử (tuỳ chọn — bỏ trống = tắt)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
